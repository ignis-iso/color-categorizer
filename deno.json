{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "dom.iterable", "deno.ns", "esnext"]
  },
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "check": "deno check src/main.tsx"
  },
  "imports": {
    "react": "npm:react@^18.3.1",
    "react-dom/client": "npm:react-dom@^18.3.1/client",
    "react/jsx-runtime": "npm:react@^18.3.1/jsx-runtime",
    "@types/react": "npm:@types/react@^18.3.12",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.3.4",
    "vite": "npm:vite@^5.4.11"
  }
}
